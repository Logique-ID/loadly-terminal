# Loadly API key — Loadly dashboard → Account → API Key.
# Copy this file to .env and paste your key. .env is gitignored.
# In CI the same value comes from the LOADLY_API_KEY GitHub secret.
LOADLY_API_KEY=

# Optional: more Loadly accounts, merged into the same page. JSON object of
# account name -> API key, on one line. The name is published in data/apps.json
# (the worker uses it to pick the key), so pick a plain label, not a secret.
# In CI this comes from the LOADLY_API_KEYS GitHub secret.
# LOADLY_API_KEYS={"other":"<api key>"}
